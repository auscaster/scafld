# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
/build/
/dist/
/bin/*
!/bin/scafld
.tools/
*.egg-info/
*.tgz
*.test
coverage.out

# package build outputs
/package/pypi/build/
/package/pypi/dist/
/package/pypi/src/*.egg-info/
/.stage/

# OS
.DS_Store
Thumbs.db

# runx runtime state (governance receipts from runx-managed runs; never project-owned)
.runx/

# scafld runtime state
# Keep project-owned config, trusted keys and live specs in git. Generated
# copies (core, prompts, the spec archive and examples) and local runtime state
# stay out, as the repository tests require.
!.scafld/
!.scafld/config.yaml
!.scafld/specs/
!.scafld/specs/**
!.scafld/trusted-keys.json
.scafld/receipts/
.scafld/config.local.yaml
.scafld/core/
.scafld/prompts/
.scafld/specs/archive/
.scafld/specs/examples/
.scafld/locks/
.scafld/keys/
.scafld/private-keys/
.scafld/**/*.key
.scafld/**/*.pem
.scafld/runs/
